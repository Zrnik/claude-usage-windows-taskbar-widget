#!/bin/sh
set -e

OLD_PLASMOID_ID="org.zrnik.claude-usage-widget"
OLD_PLASMOID_PATTERN="org[.]zrnik[.]claude-usage-widget"
PLASMOID_ID="eu.zrnik.ai-usage-widget"

systemctl --global enable claude-usage-widget.service >/dev/null 2>&1 || true

if command -v loginctl >/dev/null 2>&1; then
  loginctl list-users --no-legend 2>/dev/null | while read -r uid user rest; do
    [ -n "$uid" ] || continue
    [ -S "/run/user/$uid/bus" ] || continue
    home="$(getent passwd "$user" | cut -d: -f6)"
    [ -n "$home" ] || continue

    appletsrc="$home/.config/plasma-org.kde.plasma.desktop-appletsrc"
    if [ -f "$appletsrc" ]; then
      runuser -u "$user" -- cp -n "$appletsrc" "$appletsrc.pre-ai-usage-widget-migration" 2>/dev/null || true
      runuser -u "$user" -- sed -i "s/$OLD_PLASMOID_PATTERN/$PLASMOID_ID/g" "$appletsrc" 2>/dev/null || true
    fi

    # This is a one-time migration from the old local package identifier. Do
    # not move an already current user-local plasmoid on every package upgrade:
    # Plasma owns its state for that package and an upgrade must not disturb it.
    old_local_plasmoid="$home/.local/share/plasma/plasmoids/$OLD_PLASMOID_ID"
    if [ -d "$old_local_plasmoid" ]; then
      runuser -u "$user" -- mv "$old_local_plasmoid" "$old_local_plasmoid.disabled-by-deb-package" 2>/dev/null || true
    fi

    XDG_RUNTIME_DIR="/run/user/$uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
      runuser -u "$user" -- systemctl --user daemon-reload >/dev/null 2>&1 || true

    XDG_RUNTIME_DIR="/run/user/$uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
      runuser -u "$user" -- systemctl --user reset-failed claude-usage-widget.service >/dev/null 2>&1 || true

    XDG_RUNTIME_DIR="/run/user/$uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
      runuser -u "$user" -- systemctl --user enable claude-usage-widget.service >/dev/null 2>&1 || true

    XDG_RUNTIME_DIR="/run/user/$uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
      runuser -u "$user" -- systemctl --user restart claude-usage-widget.service >/dev/null 2>&1 || true

    if command -v kbuildsycoca6 >/dev/null 2>&1; then
      XDG_RUNTIME_DIR="/run/user/$uid" \
      DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
        runuser -u "$user" -- kbuildsycoca6 --noincremental >/dev/null 2>&1 || true
    fi
  done
fi

exit 0
